# Editor types for Python page code (<script type="text/python">), so the IDE knows the
# page's globals without imports. Pyright and Pylance read this file as extra builtins; it
# never runs. It lists only what the browser supports: docs/api.md is the reference, and
# browser/src/host.rs is the truth. Anything else fails at runtime with "... is not
# supported yet".

from typing import Any, Callable, Iterator, Literal

Listener = Callable[..., object]

class Promise:
    """A host promise. `then` calls one callback later and returns None: nest, don't chain."""
    def then(self, on_value: Callable[[Any], object] | None = None, on_error: Callable[[str], object] | None = None) -> None: ...

class Data:
    """Plain data from the host (Response.json(), IndexedDB): read by name or index."""
    length: int
    def __getattr__(self, name: str) -> Any: ...
    def __getitem__(self, key: int | str) -> Any: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Any]: ...

class Event:
    type: str
    target: Any
    currentTarget: Any
    defaultPrevented: bool
    # Mouse and pointer events.
    clientX: float
    clientY: float
    x: float
    y: float
    pageX: float
    pageY: float
    screenX: float
    screenY: float
    button: int
    buttons: int
    # Keyboard events.
    key: str
    code: Any  # str for keys, int for a WebSocket close
    repeat: bool
    altKey: bool
    ctrlKey: bool
    shiftKey: bool
    metaKey: bool
    # popstate, hashchange, WebSocket message and close.
    state: Any
    oldURL: str
    newURL: str
    data: str
    reason: str
    wasClean: bool
    def preventDefault(self) -> None: ...
    def stopPropagation(self) -> None: ...
    def stopImmediatePropagation(self) -> None: ...

class EventTarget:
    def addEventListener(self, type: str, listener: Callable[[Event], object]) -> None: ...
    def removeEventListener(self, type: str, listener: Callable[[Event], object]) -> None: ...

class DOMRect:
    x: float
    y: float
    width: float
    height: float
    top: float
    left: float
    right: float
    bottom: float

class DOMTokenList:
    length: int
    value: str
    def add(self, *tokens: str) -> None: ...
    def remove(self, *tokens: str) -> None: ...
    def toggle(self, token: str, force: bool | None = None) -> bool: ...
    def contains(self, token: str) -> bool: ...
    def item(self, index: int) -> str | None: ...

class CSSStyleDeclaration:
    """Any CSS property in camelCase: el.style.backgroundColor = 'red'."""
    cssText: str
    length: int
    def getPropertyValue(self, name: str) -> str: ...
    def setProperty(self, name: str, value: str | None) -> None: ...
    def removeProperty(self, name: str) -> str: ...
    def __getattr__(self, name: str) -> str: ...
    def __setattr__(self, name: str, value: str) -> None: ...

class DOMStringMap:
    """data-* attributes: el.dataset.userId or el.dataset['userId'] is data-user-id."""
    def __getattr__(self, name: str) -> str | None: ...
    def __setattr__(self, name: str, value: str) -> None: ...
    def __getitem__(self, name: str) -> str | None: ...
    def __setitem__(self, name: str, value: str) -> None: ...

class NodeList:
    """A snapshot (not live) of nodes."""
    length: int
    def item(self, index: int) -> Element | None: ...
    def __getitem__(self, index: int) -> Element: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Element]: ...

class CanvasRenderingContext2D:
    fillStyle: str
    strokeStyle: str
    lineWidth: float
    font: str
    canvas: Element
    def fillRect(self, x: float, y: float, w: float, h: float) -> None: ...
    def strokeRect(self, x: float, y: float, w: float, h: float) -> None: ...
    def clearRect(self, x: float, y: float, w: float, h: float) -> None: ...
    def rect(self, x: float, y: float, w: float, h: float) -> None: ...
    def beginPath(self) -> None: ...
    def moveTo(self, x: float, y: float) -> None: ...
    def lineTo(self, x: float, y: float) -> None: ...
    def arc(self, x: float, y: float, radius: float, start: float, end: float, counterclockwise: bool = False) -> None: ...
    def closePath(self) -> None: ...
    def fill(self) -> None: ...
    def stroke(self) -> None: ...
    def fillText(self, text: str, x: float, y: float) -> None: ...
    def save(self) -> None: ...
    def restore(self) -> None: ...

class Element(EventTarget):
    """An element or a text node."""
    id: str
    className: str
    tagName: str
    textContent: str
    innerHTML: str
    outerHTML: str  # read only
    value: str
    checked: bool
    disabled: bool
    classList: DOMTokenList
    style: CSSStyleDeclaration
    dataset: DOMStringMap
    children: NodeList
    childNodes: NodeList
    childElementCount: int
    parentElement: Element | None
    parentNode: Element | Document | None
    firstChild: Element | None
    lastChild: Element | None
    firstElementChild: Element | None
    lastElementChild: Element | None
    nextSibling: Element | None
    previousSibling: Element | None
    nextElementSibling: Element | None
    previousElementSibling: Element | None
    nodeType: int
    nodeName: str
    nodeValue: str | None
    data: str
    # <canvas> only.
    width: int
    height: int
    def querySelector(self, selectors: str) -> Element | None: ...
    def querySelectorAll(self, selectors: str) -> NodeList: ...
    def appendChild(self, child: Element) -> Element: ...
    def insertBefore(self, child: Element, before: Element | None) -> Element: ...
    def replaceChild(self, new: Element, old: Element) -> Element: ...
    def removeChild(self, child: Element) -> Element: ...
    def remove(self) -> None: ...
    def cloneNode(self, deep: bool = False) -> Element: ...
    def contains(self, other: Element | None) -> bool: ...
    def getAttribute(self, name: str) -> str | None: ...
    def setAttribute(self, name: str, value: str) -> None: ...
    def removeAttribute(self, name: str) -> None: ...
    def hasAttribute(self, name: str) -> bool: ...
    def getBoundingClientRect(self) -> DOMRect: ...
    def focus(self) -> None: ...
    def blur(self) -> None: ...
    def getContext(self, kind: Literal['2d']) -> CanvasRenderingContext2D | None: ...
    def toDataURL(self) -> str: ...

class Document(EventTarget):
    body: Element | None
    head: Element | None
    documentElement: Element | None
    cookie: str
    location: Location
    def querySelector(self, selectors: str) -> Element | None: ...
    def querySelectorAll(self, selectors: str) -> NodeList: ...
    def getElementById(self, id: str) -> Element | None: ...
    def createElement(self, tag: str) -> Element: ...
    def createTextNode(self, text: str) -> Element: ...

class Headers:
    def get(self, name: str) -> str | None: ...
    def has(self, name: str) -> bool: ...

class Response:
    ok: bool
    status: int
    statusText: str
    url: str
    redirected: bool
    type: str
    bodyUsed: bool
    headers: Headers
    def text(self) -> Promise: ...
    def json(self) -> Promise: ...

class Storage:
    length: int
    def getItem(self, key: str) -> str | None: ...
    def setItem(self, key: str, value: str) -> None: ...
    def removeItem(self, key: str) -> None: ...
    def clear(self) -> None: ...
    def key(self, index: int) -> str | None: ...

class Location:
    href: str
    protocol: str
    host: str
    hostname: str
    port: str
    pathname: str
    search: str
    hash: str
    origin: str
    def assign(self, url: str) -> None: ...
    def replace(self, url: str) -> None: ...
    def reload(self) -> None: ...

class History:
    length: int
    state: Any
    def pushState(self, state: Any, unused: str, url: str | None = None) -> None: ...
    def replaceState(self, state: Any, unused: str, url: str | None = None) -> None: ...
    def back(self) -> None: ...
    def forward(self) -> None: ...
    def go(self, delta: int = 0) -> None: ...

class Navigator:
    userAgent: str
    language: str

class Performance:
    timeOrigin: float
    def now(self) -> float:
        """Milliseconds since the page started; never goes back."""

class Console:
    def log(self, *args: object) -> None: ...
    def info(self, *args: object) -> None: ...
    def warn(self, *args: object) -> None: ...
    def error(self, *args: object) -> None: ...
    def debug(self, *args: object) -> None: ...

class _Math:
    def random(self) -> float: ...

class WebSocketObject(EventTarget):
    """Text messages only. Events: open, message (event.data), error, close."""
    url: str
    readyState: int
    protocol: str
    extensions: str
    bufferedAmount: int
    binaryType: str
    onopen: Listener | None
    onmessage: Listener | None
    onerror: Listener | None
    onclose: Listener | None
    CONNECTING: int
    OPEN: int
    CLOSING: int
    CLOSED: int
    def send(self, data: str) -> None: ...
    def close(self, code: int | None = None, reason: str | None = None) -> None: ...

class XMLHttpRequestObject(EventTarget):
    """Async only; text responses only."""
    readyState: int
    status: int
    statusText: str
    responseText: str
    response: str
    responseURL: str
    responseType: Literal['', 'text']
    onreadystatechange: Listener | None
    onload: Listener | None
    onerror: Listener | None
    onloadend: Listener | None
    def open(self, method: str, url: str) -> None: ...
    def setRequestHeader(self, name: str, value: str) -> None: ...
    def send(self, body: str | None = None) -> None: ...
    def getResponseHeader(self, name: str) -> str | None: ...
    def getAllResponseHeaders(self) -> str: ...

class IDBRequest(EventTarget):
    """Events: success, error (and upgradeneeded for open)."""
    result: Any
    error: Any
    readyState: str
    onsuccess: Listener | None
    onerror: Listener | None
    onupgradeneeded: Listener | None

class IDBObjectStore:
    name: str
    keyPath: str | None
    autoIncrement: bool
    def put(self, value: Any, key: Any = None) -> IDBRequest: ...
    def add(self, value: Any, key: Any = None) -> IDBRequest: ...
    def get(self, key: Any) -> IDBRequest: ...
    def delete(self, key: Any) -> IDBRequest: ...
    def getAll(self) -> IDBRequest: ...
    def count(self) -> IDBRequest: ...
    def clear(self) -> IDBRequest: ...

class IDBTransaction(EventTarget):
    """Events: complete, error, abort."""
    mode: str
    oncomplete: Listener | None
    onerror: Listener | None
    onabort: Listener | None
    def objectStore(self, name: str) -> IDBObjectStore: ...

class IDBDatabase(EventTarget):
    name: str
    version: int
    objectStoreNames: Data
    def createObjectStore(self, name: str, options: dict[str, Any] | None = None) -> IDBObjectStore: ...
    def deleteObjectStore(self, name: str) -> None: ...
    def transaction(self, stores: str | list[str], mode: Literal['readonly', 'readwrite'] = 'readonly') -> IDBTransaction: ...
    def close(self) -> None: ...

class IDBFactory:
    def open(self, name: str, version: int | None = None) -> IDBRequest: ...
    def deleteDatabase(self, name: str) -> IDBRequest: ...

class Window(EventTarget):
    document: Document
    console: Console
    location: Location
    history: History
    navigator: Navigator
    performance: Performance
    localStorage: Storage
    sessionStorage: Storage
    indexedDB: IDBFactory
    innerWidth: int
    innerHeight: int
    devicePixelRatio: float
    scrollX: float
    scrollY: float
    pageXOffset: float
    pageYOffset: float
    def scrollTo(self, x: float, y: float) -> None: ...
    def scroll(self, x: float, y: float) -> None: ...
    def scrollBy(self, x: float, y: float) -> None: ...
    def setTimeout(self, f: Listener, ms: float = 0) -> int: ...
    def setInterval(self, f: Listener, ms: float = 0) -> int: ...
    def clearTimeout(self, handle: int | None) -> None: ...
    def clearInterval(self, handle: int | None) -> None: ...
    def requestAnimationFrame(self, f: Callable[[float], object]) -> int: ...
    def cancelAnimationFrame(self, handle: int | None) -> None: ...
    def fetch(self, input: str, init: dict[str, Any] | None = None) -> Promise: ...

window: Window
document: Document
console: Console
Math: _Math
location: Location
navigator: Navigator
performance: Performance
history: History
localStorage: Storage
sessionStorage: Storage
indexedDB: IDBFactory

def setTimeout(f: Listener, ms: float = 0, *args: Any) -> int: ...
def setInterval(f: Listener, ms: float = 0, *args: Any) -> int: ...
def clearTimeout(handle: int | None) -> None: ...
def clearInterval(handle: int | None) -> None: ...
def requestAnimationFrame(f: Callable[[float], object]) -> int: ...
def cancelAnimationFrame(handle: int | None) -> None: ...
def fetch(input: str, init: dict[str, Any] | None = None) -> Promise:
    """init: method, headers (dict), body (str), credentials. Settles with a Response."""
def WebSocket(url: str, protocols: str | list[str] | None = None) -> WebSocketObject: ...
def XMLHttpRequest() -> XMLHttpRequestObject: ...
